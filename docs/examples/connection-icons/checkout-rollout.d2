direction: right
vars.d2-config: {animate-interval: 4s; pad: 22}
style.fill: "#f7f8f4"

classes.service: {
  width: 160
  height: 64
  style: {fill: "#ffffff"; stroke: "#86958c"; border-radius: 9; font-size: 16}
}
edge: "Checkout gateway" {class: service}
stable: "Stable · v2.14" {class: service; style.fill: "#d9ebe0"}
canary: "Canary · v2.15" {class: service; style.fill: "#f8e3cb"}
inventory: "Inventory service" {class: service}

edge -> stable: 95% {
  icon.style.animated: 9.5/s
  style.stroke: "#267050"
}
edge -> canary: 5% {
  icon.style.animated: 0.5/s
  style.stroke: "#a45120"
}
stable -> inventory: reserve stock {style.stroke: "#69796d"}
canary -> inventory: reserve stock {style.stroke: "#69796d"}

steps: {
  expand: {
    (edge -> stable)[0]: 50% {icon.style.animated: 5/s}
    (edge -> canary)[0]: 50% {icon.style.animated: 5/s}
  }
  promote: {
    (edge -> stable)[0]: 0% {icon.style.animated: 0/s}
    (edge -> canary)[0]: 100% {icon.style.animated: 10/s}
  }
}
