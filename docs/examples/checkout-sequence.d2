vars: {
  d2-config: {
    animate-duration: 650ms
    layout-engine: tala
    pad: 24
  }
}

shape: sequence_diagram
style.fill: "#faf9f5"

classes: {
  participant: {
    width: 180
    height: 52
    style: {
      fill: "#eef2fd"
      stroke: "#8597c5"
      stroke-width: 1
      font-color: "#202f52"
      bold: true
      border-radius: 8
    }
  }
  call: {style: {stroke: "#2e50b3"; font-color: "#24345c"}}
  reply: {style: {stroke: "#4c6970"; font-color: "#324f55"; stroke-dash: 4}}
}

checkout: Checkout {class: participant}
orders: Orders API {class: participant}
inventory: Inventory {class: participant}

checkout.session -> orders.confirm: Place order {class: call}
orders.confirm -> inventory.reserve: Reserve stock {class: call}

steps: {
  confirmation: {
    inventory.reserve -> orders.confirm: Stock reserved {class: reply}
    orders.confirm -> checkout.session: Order confirmed {class: reply}
  }
}
