# d2 marks.d2 marks.svg
direction: right

classes: {
  async: {
    annotation: lasso, round everything in a class {shape: lasso}
  }
}

client: Client
api: API
cache: Cache
db: Database {
  primary: {shape: cylinder}
  replica: {shape: cylinder}
  primary -> replica
}
queue: Queue {class: async}
worker: Worker {class: async}
client -> api
api -> cache
api -> db.primary
api -> queue -> worker

# Each note names the mark it comes with.
api.annotation: circle, the default
cache.annotation: box {shape: box}
db.annotation: brace, the default for a container
db.primary.annotation.shape: underline
db.replica.annotation: highlight {shape: highlight}
client.annotation: cross {shape: cross; near: bottom-center}
(api -> cache)[0].annotation: trace, the default for a connection
(api -> db.primary)[0].annotation: {shape: cross}
(client -> api)[0].annotation: arrow {shape: arrow}

annotation: |md Every mark sits on top of the layout. **Nothing moved** to make room. |
