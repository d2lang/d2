# d2 quorum.d2 quorum.svg
vars: {
  d2-config: {
    animate-interval: 1500ms
    animate-duration: 900ms
    pad: 30
  }
}
direction: right

classes: {
  acked: {
    annotation: quorum = 2 of 3 {shape: lasso; near: bottom-center}
  }
}

client: Client
db: orders-db {
  primary: {shape: cylinder}
  r1: replica 1 {shape: cylinder}
  r2: replica 2 {shape: cylinder}
  primary -> r1
  primary -> r2
}
client -> db.primary: INSERT

steps: {
  write: {
    annotation: |md A write lands on the [primary](db.primary). |
    (client -> db.primary)[0].annotation.shape: highlight
  }
  replicate: {
    annotation: |md The primary copies it to both replicas. |
    db: {
      (primary -> r1)[0].annotation: 3 ms
      (primary -> r2)[0].annotation: still waiting
    }
  }
  lag: {
    annotation: |md Replica 2 is slow today. |
    db.r2.annotation: 4 s behind {shape: arrow}
  }
  quorum: {
    annotation: |md The write commits anyway: two of three have it. |
    db.primary.class: acked
    db.r1.class: acked
  }
  moral: {
    annotation: |md One slow replica cannot hold up a write. |
    db: {
      (primary -> r2)[0].annotation.shape: cross
    }
  }
}
